{
  "name": "shipping-bill-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Refactored Shipping Bill creation frontend — clean architecture over the assignment-01 starter, with API-ready mock services.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
